#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# Use a user-local Bun installation if the system PATH does not contain Bun.
if ! command -v bun >/dev/null 2>&1 && [[ -x "$HOME/.bun/bin/bun" ]]; then
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "Egeria resume failed: Bun is unavailable; rerun .agents/setup" >&2
  exit 1
fi

if [[ ! -d node_modules ]]; then
  echo "Egeria resume failed: dependencies are missing; rerun .agents/setup" >&2
  exit 1
fi

echo "Egeria is ready (Bun $(bun --version))"
