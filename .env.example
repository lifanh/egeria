# Egeria configuration
# Bun loads this file automatically when copied to .env.

# --- Model ---
MODEL_PROVIDER=google-vertex
MODEL_NAME=gemini-2.5-flash

# Google Vertex API key (express mode). Get one from
# https://aistudio.google.com/ or the Vertex AI console.
API_KEY=

# Optional: only needed if you use a service-account flow instead of
# express-mode API key. Leave unset for the default API-key path.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=

# --- Storage ---
NOTES_DIR=./notes

# --- Safety / reliability ---
MAX_AGENT_STEPS=5
LLM_TIMEOUT_MS=30000
TOOL_TIMEOUT_MS=10000

# --- Observability (optional Langfuse tracing) ---
# Set both keys to enable Langfuse tracing for AI SDK model/tool spans.
# Prompt and response content recording is disabled; spans include metadata.
# EU cloud: https://cloud.langfuse.com
# US cloud: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1

# Optional: enable while troubleshooting missing traces.
# LANGFUSE_LOG_LEVEL=DEBUG
