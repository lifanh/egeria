# Egeria configuration
# Bun loads this file automatically when copied to .env.

# --- Model ---
MODEL_PROVIDER=google-vertex
MODEL_NAME=gemini-2.5-flash

# Google Vertex API key (express mode). Get one from
# https://aistudio.google.com/ or the Vertex AI console.
API_KEY=

# Optional: only needed if you use a service-account flow instead of
# express-mode API key. Leave unset for the default API-key path.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=

# --- Storage ---
NOTES_DIR=./notes

# --- Safety / reliability ---
MAX_AGENT_STEPS=5
LLM_TIMEOUT_MS=30000
TOOL_TIMEOUT_MS=10000
