{
  "name": "egeria",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "test": "bun test",
    "test:agentos-memory": "bun run agentos:build && node tests/agentos-memory.integration.ts",
    "agentos:server": "node src/agentos/server.ts",
    "agentos:client": "bun run agentos:build && node src/agentos/client.ts",
    "agentos:build": "bun build src/agentos/memory-extension.ts --target=node --format=cjs --minify --outfile=dist/egeria-memory.cjs",
    "web": "bun run src/web/server.ts",
    "web:build": "bun build src/workspace/server.ts --target=node --format=cjs --minify --outfile=dist/egeria-durable.cjs && bun build src/web/app.ts --outdir=dist/web --target=browser"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@agentos-software/pi": "^0.2.7",
    "@ai-sdk/google-vertex": "^4.0.126",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@langfuse/otel": "^5.3.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@rivet-dev/agentos": "^0.2.14",
    "ai": "^6.0.177",
    "effect": "^3.21.2",
    "zod": "^4.4.3"
  }
}
